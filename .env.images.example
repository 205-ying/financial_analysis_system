# 直接拉取镜像运行示例配置

BACKEND_IMAGE=ghcr.io/205-ying/financial-analysis-system-backend:latest
FRONTEND_IMAGE=ghcr.io/205-ying/financial-analysis-system-frontend:latest

APP_NAME=餐饮企业财务分析系统
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

POSTGRES_DB=financial_analysis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=80

DATABASE_URL=postgresql+asyncpg://postgres:change-me@postgres:5432/financial_analysis
DATABASE_ECHO=false

JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost","http://127.0.0.1"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_ROTATION=1 day
LOG_RETENTION=30 days

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
AUTO_SEED=true